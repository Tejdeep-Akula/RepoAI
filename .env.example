# Copy to .env before starting PostgreSQL. .env is ignored by Git.
REPOAI_DB_NAME=repoai
REPOAI_DB_USER=repoai_admin
REPOAI_DB_PORT=5432
# Set a unique local password. An empty value prevents Compose from starting.
# Single-quote passwords containing $ to prevent Compose interpolation.
REPOAI_DB_PASSWORD=
