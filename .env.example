# Copy to .env before starting the application stack. .env is ignored by Git.
REPOAI_DB_NAME=repoai
REPOAI_DB_USER=repoai_admin
REPOAI_DB_PORT=5432
# Generate a unique hex password with: openssl rand -hex 32
# An empty value prevents Compose from starting.
REPOAI_DB_PASSWORD=

# Google OAuth web client ID (public client identifier, not a secret).
REPOAI_GOOGLE_CLIENT_ID=
# Generate a signing key with: openssl rand -base64 48
# Keep this secret private and use the same value for every API replica.
REPOAI_JWT_SIGNING_KEY=

# Ollama runs outside this Compose stack; on Docker Desktop, the default reaches the host.
REPOAI_OLLAMA_ENDPOINT=http://host.docker.internal:11434
REPOAI_OLLAMA_MODEL=qwen2.5-coder:7b

# Local-only published ports.
REPOAI_API_PORT=5080
REPOAI_FRONTEND_PORT=3000

# Override these for Docker Hub releases; use a version tag instead of "local".
REPOAI_IMAGE_NAMESPACE=repoai
REPOAI_IMAGE_TAG=latest
